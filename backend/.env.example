# Copy to backend/.env and edit. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SMART_SECRET_KEY=
SMART_SHOP_NAME=Smart Retail Checkout
SMART_SHOP_ADDRESS=
SMART_TIMEZONE=Asia/Kolkata
SMART_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Model files (relative paths are relative to the project root)
SMART_KERAS_MODEL=full_model.keras
SMART_YOLO_MODEL=yolov8m.pt
SMART_CNN_CONFIDENCE=0.8
SMART_YOLO_CONFIDENCE=0.25
# Set to 0 to run without loading AI models (manual billing only)
SMART_AI_ENABLED=1
